#!/bin/sh
# Scoped compatibility shim for scripts/subgen.py. The installed CLI rejects the
# user's `ultra` reasoning setting for gpt-5.4; add only the supported override.
REAL_CODEX=/Users/za/.local/node/bin/codex
command_name=$1
shift
exec "$REAL_CODEX" "$command_name" -c 'model_reasoning_effort="xhigh"' "$@"
