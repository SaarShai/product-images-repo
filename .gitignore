.DS_Store
*.tmp
*.log
__pycache__/
.pytest_cache/
.venv/
node_modules/
wiki/.brainer/
# Brainer layout: central skills/ is the tracked source of truth (project +
# vendored Brainer skills). The host dirs below are per-machine symlink targets
# created by ./install.sh — ignored, never committed.
.codex/skills/
.cursor/skills/
.cursor/rules/
.gemini/skills/
.claude/skills/

# Keep generated outputs local unless explicitly curated.
tasks/*/outputs/generated/*
!tasks/*/outputs/generated/.gitkeep

# transient runtime state (not work product)
.claude/state/
.brainer/
.secrets/

.venv-gen/
.venv-*/
.iopaint-models/
/princess/
__pycache__/
*.pyc
.cache/

# improvement-run scratch images (regenerable); keep the .md docs + research + eval manifest + scripts
tasks/improve/_*.png
tasks/improve/**/_*.png
tasks/improve/style-packet-test/
tasks/improve/eval/_tmp*.png

# nyc-taxi: keep deliverables (out/), drop scratch (work/) + the read-only Drive source copy (src/)
tasks/nyc-taxi/work/
tasks/nyc-taxi/src/

# princess-sharpen: 1.4GB of regenerable scratch/intermediates (work/src/reup/final/small) — task unfinished; tooling lives in scripts/
tasks/princess-sharpen/

# cap-juluca: result images live in the Drive Images/ folder, not the repo
tasks/cap-juluca/outputs/generated/
tasks/cap-juluca/outputs/final/
tasks/cap-juluca/outputs/reviews/

# device-handoff prompt (contains live API keys — never commit)
HANDOFF.md

# --- 2026-07-07 cleanup: regenerable binaries, worktrees, scratch ---
# nested git worktree (separate checkout — never commit into the parent repo)
.claude/worktrees/
# repo-root scratch: one-off round scripts + intermediates (durable tooling lives in scripts/)
/scratchpad/
# workflow preview PNGs (regenerable)
/workflows/
# editor/OS/proc leftovers
*.bak
*.orig
*.pid

# Marine Pod upscale — side task; multi-GB upscaled waves + source .ai stay local (relink is done in Illustrator, not git)
tasks/marine-pod-upscale/

# marriott-hospital: keep the specs/scripts/docs; drop regenerable render outputs
tasks/marriott-hospital/outputs/

# cap-juluca: result images live in the Drive Images/ folder, not the repo
tasks/cap-juluca/Images/

# workflow-rebuild R&D: keep docs (md/json/sh/py); drop the ~1GB of generated round images
tasks/workflow-rebuild/**/raws/
tasks/workflow-rebuild/**/raws-*/
tasks/workflow-rebuild/**/board/
tasks/workflow-rebuild/**/boards/
tasks/workflow-rebuild/**/gates/
tasks/workflow-rebuild/**/gates-*/
tasks/workflow-rebuild/**/overlays/
tasks/workflow-rebuild/**/*.png
tasks/workflow-rebuild/**/*.jpg

# REVIEW is a transient local inbox — boards regenerate from tasks/; keep only the .md notes
REVIEW/**/*.png
REVIEW/**/*.jpg
REVIEW/**/*.jpeg
REVIEW/**/*.mp4
