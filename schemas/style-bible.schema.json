{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "style-bible.schema.json",
  "title": "Screenery Style Bible",
  "type": "object",
  "$comment": "Top-level additionalProperties intentionally remains true for additive evolution. collection is required when refs_by_role is present so legacy STYLE-SPEC YAML plus bible_version remains schema-compatible.",
  "additionalProperties": true,
  "required": [
    "bible_version",
    "mood_words",
    "art_medium",
    "rendering_finish",
    "color_palette",
    "line_quality",
    "shape_language",
    "detail_density",
    "motif_vocabulary",
    "texture_rules",
    "anti_style",
    "reference_images",
    "reference_role_map",
    "per_surface_palette",
    "warm_cool_structure",
    "set_consistency",
    "review_gate",
    "signage_text_rule",
    "character_prop_proportions",
    "geometry_contract"
  ],
  "allOf": [
    {
      "if": {
        "required": ["refs_by_role"]
      },
      "then": {
        "required": ["collection"]
      }
    }
  ],
  "properties": {
    "bible_version": {
      "type": "integer",
      "minimum": 1
    },
    "collection": {
      "type": "string",
      "minLength": 1
    },
    "mood_words": {
      "type": "object"
    },
    "art_medium": {
      "type": "object"
    },
    "rendering_finish": {
      "type": "object"
    },
    "color_palette": {
      "type": "object"
    },
    "line_quality": {
      "type": "object"
    },
    "shape_language": {
      "type": "object"
    },
    "detail_density": {
      "type": "object"
    },
    "motif_vocabulary": {
      "type": "object"
    },
    "texture_rules": {
      "type": "object"
    },
    "anti_style": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reference_images": {
      "type": "object"
    },
    "reference_role_map": {
      "type": "object"
    },
    "per_surface_palette": {
      "type": "object"
    },
    "warm_cool_structure": {
      "type": "object"
    },
    "set_consistency": {
      "type": "object"
    },
    "review_gate": {
      "description": "Free-text review gate string for new bibles; legacy STYLE-SPEC objects are accepted for back-compat.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object"
        }
      ]
    },
    "signage_text_rule": {
      "type": "object"
    },
    "character_prop_proportions": {
      "type": "object"
    },
    "geometry_contract": {
      "type": "object"
    },
    "refs_by_role": {
      "type": "object",
      "required": [
        "architecture_anchor",
        "medium_anchor",
        "palette",
        "content_only",
        "anti_example"
      ],
      "additionalProperties": false,
      "properties": {
        "architecture_anchor": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "medium_anchor": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "content_only": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "anti_example": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "motif_sheet": {
      "type": "string"
    },
    "color_script": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["surface", "hex", "note"],
        "additionalProperties": true,
        "properties": {
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "hex": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "forbidden_props": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
